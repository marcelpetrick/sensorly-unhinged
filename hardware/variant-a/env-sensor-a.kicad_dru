(version 1)

# Generated by tools/boardgen - edit the generator, not this file.
# Variant A (Compact), HW A1

(rule "sensor island trace width"
	(constraint track_width (min 0.13mm) (max 0.15mm))
	(condition "A.NetClass == 'SensorIsland'")
	# EDS S3.1: the four island traces conduct 5x more heat than the
	# whole FR-4 neck. Widening them is a thermal change, not a
	# routing convenience.
)

(rule "no vias on the sensor nets"
	(constraint disallow via)
	(condition "A.NetClass == 'SensorIsland'")
	# EDS S3.1.2: no stitching or thermal vias anywhere on the island
	# path - a via is a copper column straight through the board.
)

(rule "power track width"
	(constraint track_width (min 0.4mm))
	(condition "A.NetClass == 'Power' && A.Type == 'Track'")
)

(rule "USB differential pair"
	(constraint diff_pair_gap (min 0.15mm) (opt 0.2mm))
	(constraint diff_pair_uncoupled (max 2mm))
	(condition "A.NetClass == 'USB'")
)

(rule "copper to board edge"
	(constraint edge_clearance (min 0.3mm))
)

(rule "JLCPCB-class minimum trace"
	(constraint track_width (min 0.127mm))
	# P-04: nothing that needs an advanced process.
)

(rule "JLCPCB-class minimum drill"
	(constraint hole_size (min 0.2mm))
)
